# Copy to .env and fill in. Never commit .env.

# App
APP_NAME="Company Fleet - Vehicle Booking"
ENV=development            # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
TIMEZONE=Africa/Nairobi
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://fleet_user:change-me@localhost:5432/fleet_booking
TEST_DATABASE_URL=postgresql+psycopg://fleet_user:change-me@localhost:5432/fleet_booking_test

# Auth
SECRET_KEY=generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin (created by the seed command)
FIRST_ADMIN_EMAIL=admin@company.example
FIRST_ADMIN_PASSWORD=change-me-now

# Odometer photo storage
STORAGE_BACKEND=local      # local | s3 (later)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Google Maps (Places and Routes)
GOOGLE_MAPS_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fleet@company.example

# Web push (generate VAPID keys once)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:it@company.example

# Note: tolerance, buffers, office hours, acknowledgement limit and photo
# retention live in the settings table, not here, so admins can change them.
